theme_override_fonts/normal_font = ExtResource("4_rc7y5")
theme_override_font_sizes/normal_font_size = 35
text = "You round a crumbling stone corner and freeze. A gaunt figure in tattered robes crouches over a glowing rune circle, muttering feverishly. It slowly raises its hollow-eyed gaze to meet yours, bony fingers twitching at its sides. The air smells of burnt bone and something older — something hungry.
"
fit_content = true

